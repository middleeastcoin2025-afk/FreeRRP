name: SSH

on:
  workflow_dispatch:

jobs:
  secure-ssh:
    runs-on: ubuntu-22.04
    timeout-minutes: 3600

    steps:
      - name: Update & Install Essentials
        run: |
          sudo apt-get update -y
          sudo apt-get install -y curl ufw openssh-server

      - name: Enable Root SSH Login
        run: |
          sudo passwd -d root
          echo "root:$(openssl rand -base64 12)" | sudo chpasswd
          echo "ROOT_PASS=$(sudo cat /etc/shadow | grep root | cut -d: -f2)" >> $GITHUB_ENV
          sudo sed -i 's/^#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config || true
          sudo sed -i 's/^PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config || true
          sudo systemctl restart sshd

      - name: Install Tailscale
        run: |
          curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/jammy.gpg | sudo gpg --dearmor -o /usr/share/keyrings/tailscale-archive-keyring.gpg
          echo "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/ubuntu jammy main" | sudo tee /etc/apt/sources.list.d/tailscale.list
          sudo apt-get update
          sudo apt-get install -y tailscale
          sudo systemctl enable --now tailscaled

      - name: Connect to Tailscale
        env:
          TS_AUTHKEY: ${{ secrets.TAILSCALE_AUTH_KEY }}
        run: |
          sudo tailscale up --authkey=$TS_AUTHKEY --hostname=gh-ubuntu-${{ github.run_id }} --accept-routes --ssh
          sleep 5
          TS_IP=$(tailscale ip -4)
          echo "TAILSCALE_IP=$TS_IP" >> $GITHUB_ENV

      - name: Allow SSH in Firewall
        run: |
          sudo ufw allow 22/tcp
          sudo ufw --force enable

      - name: Show Connection Info
        run: |
          echo "======================="
          echo " SSH ACCESS INFO "
          echo "======================="
          echo "Tailscale IP: $TAILSCALE_IP"
          echo "Username: root"
          echo "Password: <see below>"
          echo "======================="
          sudo grep root /etc/shadow | cut -d: -f2 | base64
          echo ""
          echo "To connect: ssh root@${TAILSCALE_IP}"
          echo ""
          echo "Keep session active below ⬇️"

      - name: Keep SSH Session Active
        run: |
          while true; do
            echo "[$(date)] SSH still active on $TAILSCALE_IP"
            sleep 300
          done
